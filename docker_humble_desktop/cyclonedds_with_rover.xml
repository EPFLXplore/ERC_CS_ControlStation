<?xml version="1.0" encoding="UTF-8"?>
<CycloneDDS xmlns="https://cdds.io/config">
  <!--
    ** DIRECT ROVER NETWORK — Ethernet OR Wi-Fi **

    Use this file when **this computer is on the rover’s network** , whether you connect **via Ethernet** (e.g. enp129s0) or
    **via Wi-Fi** (e.g. wlp…, wlan0). Peers listed below should match your Jetsons.

    **You must set <NetworkInterface> to the NIC that actually reaches the rover**
    (the one with the 169.254.x.x / rover-LAN address). Check with: ip -br addr

    ** ROS_DOMAIN_ID ** must match on PC and Jetsons (default 0 if unset).

  -->
  <!-- "any" rather than "0": if ROS_DOMAIN_ID is ever not 0, a domain-scoped config would be
       silently ignored and the <Peers> list below would not apply, breaking discovery to the
       Jetsons with no error message. -->
  <Domain Id="any">
    <General>
      <!-- Match the interface used for rover traffic (wired or wireless). -->
      <Interfaces>
        <NetworkInterface name="eno1" />
      </Interfaces>
      <AllowMulticast>spdp</AllowMulticast>
          <!-- Stay under the 1500-byte MTU set on mikrotik so IP never fragments; one lost IP
          fragment kills the whole datagram, and DDSI-level fragments are
          individually retransmittable while IP fragments are not.
          MaxMessageSize must leave room for the RTPS header (20B), INFO_TS (12B) and the
          DATA_FRAG submessage header (~36B) on top of FragmentSize, or Cyclone cannot fit a
          whole fragment into one datagram and silently shrinks the payload it actually sends. -->
      <MaxMessageSize>1456B</MaxMessageSize>
      <FragmentSize>1344B</FragmentSize>
    </General>
    <Discovery>
      <!-- Do not declare another machine dead because of
           a short network interruption. -->
      <LeaseDuration>6s</LeaseDuration>

      <!-- Re-advertise ourselves frequently so discovery
           recovers quickly after a network interruption. -->
      <SPDPInterval>1s</SPDPInterval>
      <Peers>
        <!-- Workstation on rover LAN (uncomment + set IP if multicast discovery is unreliable) -->
        <Peer address="169.254.55.166"/>
        <Peer address="169.254.55.231"/>
        <Peer address="169.254.55.230"/>
        <Peer address="169.254.55.252"/>
        <Peer address="169.254.55.240"/>
        <!-- <Peer address="169.254.56.221"/> -->
      </Peers>
    </Discovery>
    <Internal>

      <!-- Absorb bursts / scheduling delays before the kernel
           starts dropping UDP packets. -->
      <SocketReceiveBufferSize min="8MiB"/>
      <SocketSendBufferSize min="1MiB"/>

      <!-- Small WHC: reliable writers block or drop rather than accumulate a
           backlog of stale control data. Adaptive backpressure throttles the
           writer instead of letting the queue grow. -->
      <Watermarks>
        <WhcHigh>512kB</WhcHigh>
        <WhcLow>16kB</WhcLow>
        <WhcAdaptive>true</WhcAdaptive>
      </Watermarks>

      <HeartbeatInterval min="20ms" max="250ms"/>

    </Internal>
  </Domain>
</CycloneDDS>
